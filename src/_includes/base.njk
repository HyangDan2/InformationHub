{#- InformationHub — the same header, drawer, and theme chrome as Web-HQ / the three hubs / Diary -#}
{%- set pageLang = lang or 'ko' -%}
{%- set t = i18n[pageLang] -%}
{%- set pageTitle = (title + ' · ' if title else '') + site.title -%}
{%- set altUrl = page.url | alternateUrl -%}
{%- if pageLang == 'en' -%}{%- set koHref = altUrl -%}{%- set enHref = page.url -%}{%- else -%}{%- set koHref = page.url -%}{%- set enHref = altUrl -%}{%- endif -%}
<!DOCTYPE html>
<html lang="{{ pageLang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FAFAFD">
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.url | canonical(page.url) }}">
    <link rel="alternate" hreflang="ko" href="{{ site.url | canonical(koHref) }}">
    <link rel="alternate" hreflang="en" href="{{ site.url | canonical(enHref) }}">
    <link rel="alternate" hreflang="x-default" href="{{ site.url | canonical(koHref) }}">
    <meta property="og:type" content="{% if page.url.includes('/posts/') %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="HD2Lab · InformationHub">
    <meta property="og:locale" content="{{ t.locale }}">
    <meta property="og:locale:alternate" content="{{ i18n[pageLang | otherLang].locale }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url | canonical(page.url) }}">
    <meta property="og:image" content="{{ site.ogImage }}">
    <meta property="og:image:secure_url" content="{{ site.ogImage }}">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="HD2Lab | InformationHub — daily reports, one calm place.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    <meta name="twitter:image" content="{{ site.ogImage }}">
    <script>try{var h=localStorage.getItem('hd2-theme');document.documentElement.setAttribute('data-theme',h==='dark'?'dark':'light');}catch(e){document.documentElement.setAttribute('data-theme','light');}</script>
    <link rel="stylesheet" href="{{ '/assets/hd2-theme.css' | url }}?v=20261120-info2">
    <script src="{{ '/assets/hd2-theme.js' | url }}?v=20261124-themeshare2" defer></script>
    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}?v=20261124-themeshare2">
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}?v=20261120-info2">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon-32x32.png' | url }}?v=20261120-info2">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/apple-touch-icon.png' | url }}?v=20261120-info2">
    <link rel="shortcut icon" href="{{ '/assets/favicon.ico' | url }}?v=20261120-info2">
    <script data-goatcounter="https://hd2lab.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
</head>
<body class="page-{{ page.url | pageClass }}">
    <a class="skip-link" href="#main">{{ t.a11y.skip }}</a>
    {% set chinaCurrent = navSection == 'china-ai' %}
    {% set usCurrent = navSection == 'us-markets' %}
    {% set infoCurrent = navSection == 'info-top' %}
    {% set chinaUrl = ('/en/china-ai/' if pageLang == 'en' else '/china-ai/') | url %}
    {% set usUrl = ('/en/us-markets/' if pageLang == 'en' else '/us-markets/') | url %}
    {% set homeUrl = ('/en/' if pageLang == 'en' else '/') | url %}
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="{{ homeUrl }}" aria-label="{{ t.a11y.home }}">
                <span class="mark" aria-hidden="true"></span>
                <span class="brand-name">{{ site.brand }}</span>
                <em>InformationHub</em>
            </a>
            <nav class="header-nav" aria-label="{{ t.a11y.nav }}">
                <a class="nav-tab" href="{{ site.nav.webHq }}">Web-HQ</a>
                <div class="nav-dropdown" data-nav-group="apps">
                    <a class="nav-tab nav-dropdown-trigger" href="{{ site.nav.apps }}">Apps
                        <span class="nav-caret" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0002/">Midpoint</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/AGPilot0007/">Film Studio</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0003/">Shutterplate</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0006/">DOS Player</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0018/">Statelia</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0008/">HD2Markdown Viewer</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/EDPilot0001/">Machine Learning Lab</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0011/">CinePlate</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0012/">ObjectLens</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0013/">CodePlayground</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0014/">SlideDeck</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0015/">FrameBuilder</a>
                    </div>
                </div>
                <div class="nav-dropdown" data-nav-group="play">
                    <a class="nav-tab nav-dropdown-trigger" href="{{ site.nav.play }}">Play
                        <span class="nav-caret" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/AGPilot0001/">VALKYRIE EIRA</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/CDXPilot0004/">Particle Beat</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/CDXPilot0005/">VALKYRIE</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/CDXPilot0006/">ChibiLink</a>
                    </div>
                </div>
                <a class="nav-tab" href="{{ site.nav.tech }}">Tech</a>
                <div class="nav-dropdown" data-nav-group="diary">
                    <a class="nav-tab nav-dropdown-trigger" href="{{ site.nav.diary }}">Diary
                        <span class="nav-caret" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/diary/categories/devlog/">Devlog</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/diary/categories/architecture/">Architecture</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/diary/categories/troubleshooting/">Troubleshooting</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/diary/categories/notes/">Notes</a>
                    </div>
                </div>
                <div class="nav-dropdown{% if infoCurrent or chinaCurrent or usCurrent %} is-active{% endif %}" data-nav-group="info">
                    <a class="nav-tab nav-dropdown-trigger{% if infoCurrent or chinaCurrent or usCurrent %} is-current{% endif %}" href="{{ homeUrl }}"{% if infoCurrent %} aria-current="page"{% endif %}>Info
                        <span class="nav-caret" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link{% if chinaCurrent %} is-current{% endif %}" href="{{ chinaUrl }}"{% if chinaCurrent %} aria-current="page"{% endif %}>China AI</a>
                        <a class="nav-dropdown-link{% if usCurrent %} is-current{% endif %}" href="{{ usUrl }}"{% if usCurrent %} aria-current="page"{% endif %}>US Markets</a>
                    </div>
                </div>
                <a class="nav-tab" href="{{ site.nav.about }}">About</a>
            </nav>
            <div class="header-actions">
                <button id="hd2ThemeToggle" class="hd2-theme-toggle hd2-theme-toggle--header" type="button" role="switch" aria-checked="false" aria-label="{{ t.a11y.themeToggle }}" title="{{ t.a11y.themeToggle }}">
                    <span class="hd2-theme-track" aria-hidden="true">
                        <span class="hd2-theme-slot">
                            <svg class="hd2-theme-ic" data-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.1"/><path d="M12 2.7v2.3M12 19v2.3M2.7 12h2.3M19 12h2.3M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"/></svg>
                        </span>
                        <span class="hd2-theme-slot">
                            <svg class="hd2-theme-ic" data-icon="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false"><path d="M20.4 14.4A8.6 8.6 0 0 1 9.6 3.6a8.6 8.6 0 1 0 10.8 10.8z"/></svg>
                        </span>
                        <span class="hd2-theme-thumb"></span>
                    </span>
                </button>
                <button class="menu-button" type="button" aria-label="{{ t.a11y.openMenu }}" aria-expanded="false" aria-controls="mobile-drawer">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M3 5.5H17M3 10H17M3 14.5H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <div class="drawer-backdrop" hidden></div>
    <aside id="mobile-drawer" class="mobile-drawer" aria-label="{{ t.a11y.drawer }}" aria-hidden="true">
        <div class="drawer-head">
            <span class="drawer-title"><span class="mark mark-sm" aria-hidden="true"></span><span>{{ t.a11y.drawerTitle }}</span></span>
            <button class="drawer-close" type="button" aria-label="{{ t.a11y.closeMenu }}">&times;</button>
        </div>
        <nav class="drawer-list" aria-label="{{ t.a11y.nav }}">
            <a class="drawer-item" href="{{ site.nav.webHq }}">Web-HQ</a>
            <div class="drawer-group" data-drawer-group="apps">
                <div class="drawer-row">
                    <a class="drawer-item" href="{{ site.nav.apps }}">Apps</a>
                    <button class="drawer-toggle" type="button" aria-expanded="false" aria-controls="drawer-apps-sub" aria-label="{{ t.a11y.appsSections }}">
                        <svg class="drawer-caret" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 5.75 8 10.25l4.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-apps-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0002/">Midpoint</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/AGPilot0007/">Film Studio</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0003/">Shutterplate</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0006/">DOS Player</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0018/">Statelia</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0008/">HD2Markdown Viewer</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/EDPilot0001/">Machine Learning Lab</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0011/">CinePlate</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0012/">ObjectLens</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0013/">CodePlayground</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0014/">SlideDeck</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0015/">FrameBuilder</a>
                    </div>
                </div>
            </div>
            <div class="drawer-group" data-drawer-group="play">
                <div class="drawer-row">
                    <a class="drawer-item" href="{{ site.nav.play }}">Play</a>
                    <button class="drawer-toggle" type="button" aria-expanded="false" aria-controls="drawer-play-sub" aria-label="{{ t.a11y.playSections }}">
                        <svg class="drawer-caret" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 5.75 8 10.25l4.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-play-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/AGPilot0001/">VALKYRIE EIRA</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/CDXPilot0004/">Particle Beat</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/CDXPilot0005/">VALKYRIE</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/CDXPilot0006/">ChibiLink</a>
                    </div>
                </div>
            </div>
            <a class="drawer-item" href="{{ site.nav.tech }}">Tech</a>
            <div class="drawer-group" data-drawer-group="diary">
                <div class="drawer-row">
                    <a class="drawer-item" href="{{ site.nav.diary }}">Diary</a>
                    <button class="drawer-toggle" type="button" aria-expanded="false" aria-controls="drawer-diary-sub" aria-label="{{ t.a11y.diarySections }}">
                        <svg class="drawer-caret" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 5.75 8 10.25l4.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-diary-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/diary/categories/devlog/">Devlog</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/diary/categories/architecture/">Architecture</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/diary/categories/troubleshooting/">Troubleshooting</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/diary/categories/notes/">Notes</a>
                    </div>
                </div>
            </div>
            {# the Info group starts open on every InformationHub page #}
            <div class="drawer-group is-open" data-drawer-group="info">
                <div class="drawer-row">
                    <a class="drawer-item{% if infoCurrent %} is-current{% endif %}" href="{{ homeUrl }}"{% if infoCurrent %} aria-current="page"{% endif %}>Info</a>
                    <button class="drawer-toggle" type="button" aria-expanded="true" aria-controls="drawer-info-sub" aria-label="{{ t.a11y.infoSections }}">
                        <svg class="drawer-caret" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 5.75 8 10.25l4.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-info-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem{% if chinaCurrent %} is-current{% endif %}" href="{{ chinaUrl }}"{% if chinaCurrent %} aria-current="page"{% endif %}>China AI</a>
                        <a class="drawer-subitem{% if usCurrent %} is-current{% endif %}" href="{{ usUrl }}"{% if usCurrent %} aria-current="page"{% endif %}>US Markets</a>
                    </div>
                </div>
            </div>
            <a class="drawer-item" href="{{ site.nav.about }}">About</a>
        </nav>
    </aside>

    <main id="main">
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>© {{ site.year }} {{ site.brand }}</span>
            <span class="footer-note">++ SIGNALS IN ++ NOISE OUT ++</span>
            <span class="visit-badge" data-visit-badge hidden>
                <svg class="visit-eye" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.7 8S3.9 4.1 8 4.1 14.3 8 14.3 8 12.1 11.9 8 11.9 1.7 8 1.7 8Z"/><circle cx="8" cy="8" r="1.9"/></svg>
                <span>Today <b class="visit-num" data-visit-today>—</b></span>
                <span class="visit-sep" aria-hidden="true">·</span>
                <span>Total <b class="visit-num" data-visit-total>—</b></span>
            </span>
            <a href="https://github.com/{{ site.repo }}">GitHub <span aria-hidden="true">↗</span></a>
        </div>
    </footer>
    <button id="hd2ShareToggle" class="hd2-share-toggle" type="button" aria-label="{{ t.a11y.share }}" title="{{ t.a11y.share }}" data-copied-label="{{ t.a11y.shareCopied }}">
        <svg class="hd2-share-ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9.16 10.44 14.84 7M9.16 13.56l5.68 3.44" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="17.4" cy="5.4" r="2.9" fill="currentColor"/>
            <circle cx="6.6" cy="12" r="2.9" fill="currentColor"/>
            <circle cx="17.4" cy="18.6" r="2.9" fill="currentColor"/>
        </svg>
    </button>
    <div id="hd2Toast" class="hd2-toast" role="status" aria-live="polite" aria-atomic="true">
        <svg class="hd2-toast-ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 6.5 9.4 17.1 4 11.7"/></svg>
        <span class="hd2-toast-text"></span>
    </div>
    <script src="{{ '/assets/visit-badge.js' | url }}?v=20261120-visits" defer></script>
    <script src="{{ '/assets/hd2-share.js' | url }}?v=20261124-themeshare2" defer></script>
    <script>window.INFO_HUB_BASE = "{{ ('/en/' if pageLang == 'en' else '/') | url }}";window.INFO_HUB_LANG = "{{ pageLang }}";</script>
    {% if pageScript %}<script src="{{ pageScript | url }}?v=20261120-info2" defer></script>{% endif %}
    <script src="{{ '/assets/info-lang.js' | url }}?v=20261120-info2" defer></script>
    <script src="{{ '/assets/info-nav.js' | url }}?v=20261121-nav15" defer></script>
    <script src="https://hyangdan2.github.io/nav-catalog.js?v=20261128" defer></script>
</body>
</html>
