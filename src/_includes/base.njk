{#- InformationHub — the same header, drawer, and theme chrome as Web-HQ / the three hubs / Diary -#}
{%- set pageLang = lang or 'en' -%}
{%- set pageTitle = (title + ' · ' if title else '') + site.title -%}
<!DOCTYPE html>
<html lang="{{ pageLang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FAFAFD">
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.url | canonical(page.url) }}">
    <meta property="og:type" content="{% if page.url.includes('/posts/') %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="HD2Lab · InformationHub">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url | canonical(page.url) }}">
    <meta property="og:image" content="{{ site.ogImage }}">
    <meta property="og:image:secure_url" content="{{ site.ogImage }}">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="HD2Lab | InformationHub — daily reports, one calm place.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    <meta name="twitter:image" content="{{ site.ogImage }}">
    <script>try{var h=localStorage.getItem('hd2-theme');document.documentElement.setAttribute('data-theme',h==='dark'?'dark':'light');}catch(e){document.documentElement.setAttribute('data-theme','light');}</script>
    <link rel="stylesheet" href="{{ '/assets/hd2-theme.css' | url }}?v=20261119-info">
    <script src="{{ '/assets/hd2-theme.js' | url }}?v=20261119-info" defer></script>
    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}?v=20261119-info">
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}?v=20261119-info">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon-32x32.png' | url }}?v=20261119-info">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/apple-touch-icon.png' | url }}?v=20261119-info">
    <link rel="shortcut icon" href="{{ '/assets/favicon.ico' | url }}?v=20261119-info">
</head>
<body class="page-{{ page.url | pageClass }}">
    <a class="skip-link" href="#main">Skip to content</a>
    {% set chinaCurrent = navSection == 'china-ai' %}
    {% set infoCurrent = navSection == 'info-top' %}
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="{{ '/' | url }}" aria-label="HD2Lab InformationHub home">
                <span class="mark" aria-hidden="true"></span>
                <span class="brand-name">{{ site.brand }}</span>
                <em>InformationHub</em>
            </a>
            <nav class="header-nav" aria-label="Hub categories">
                <a class="nav-tab" href="{{ site.nav.webHq }}">Web-HQ</a>
                <div class="nav-dropdown" data-nav-group="apps">
                    <a class="nav-tab nav-dropdown-trigger" href="{{ site.nav.apps }}">Apps
                        <span class="nav-caret" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/AGPilot0002/">Todo Master</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0001/">Photos</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0002/">Midpoint</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/AGPilot0007/">Film Studio</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0003/">Shutterplate</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0006/">DOS Player</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/PKPilot0008/">HD2Markdown Viewer</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/EDPilot0001/">Machine Learning Lab</a>
                    </div>
                </div>
                <div class="nav-dropdown" data-nav-group="play">
                    <a class="nav-tab nav-dropdown-trigger" href="{{ site.nav.play }}">Play
                        <span class="nav-caret" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/AGPilot0001/">VALKYRIE EIRA</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/CDXPilot0004/">Particle Beat</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/CDXPilot0005/">VALKYRIE</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/CDXPilot0006/">ChibiLink</a>
                    </div>
                </div>
                <a class="nav-tab" href="{{ site.nav.tech }}">Tech</a>
                <div class="nav-dropdown" data-nav-group="diary">
                    <a class="nav-tab nav-dropdown-trigger" href="{{ site.nav.diary }}">Diary
                        <span class="nav-caret" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/diary/categories/devlog/">Devlog</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/diary/categories/architecture/">Architecture</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/diary/categories/troubleshooting/">Troubleshooting</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/diary/categories/notes/">Notes</a>
                    </div>
                </div>
                <div class="nav-dropdown{% if infoCurrent or chinaCurrent %} is-active{% endif %}" data-nav-group="info">
                    <a class="nav-tab nav-dropdown-trigger{% if infoCurrent or chinaCurrent %} is-current{% endif %}" href="{{ '/' | url }}"{% if infoCurrent %} aria-current="page"{% endif %}>Info
                        <span class="nav-caret" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link{% if chinaCurrent %} is-current{% endif %}" href="{{ '/china-ai/' | url }}"{% if chinaCurrent %} aria-current="page"{% endif %}>China AI</a>
                    </div>
                </div>
            </nav>
            <div class="header-actions">
                <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M3 5.5H17M3 10H17M3 14.5H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <div class="drawer-backdrop" hidden></div>
    <aside id="mobile-drawer" class="mobile-drawer" aria-label="Hub navigation" aria-hidden="true">
        <div class="drawer-head">
            <span class="drawer-title"><span class="mark mark-sm" aria-hidden="true"></span><span>Navigation</span></span>
            <button class="drawer-close" type="button" aria-label="Close menu">&times;</button>
        </div>
        <nav class="drawer-list" aria-label="Hub categories">
            <a class="drawer-item" href="{{ site.nav.webHq }}">Web-HQ</a>
            <div class="drawer-group" data-drawer-group="apps">
                <div class="drawer-row">
                    <a class="drawer-item" href="{{ site.nav.apps }}">Apps</a>
                    <button class="drawer-toggle" type="button" aria-expanded="false" aria-controls="drawer-apps-sub" aria-label="Apps sections">
                        <svg class="drawer-caret" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 5.75 8 10.25l4.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-apps-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/AGPilot0002/">Todo Master</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0001/">Photos</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0002/">Midpoint</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/AGPilot0007/">Film Studio</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0003/">Shutterplate</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0006/">DOS Player</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/PKPilot0008/">HD2Markdown Viewer</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/EDPilot0001/">Machine Learning Lab</a>
                    </div>
                </div>
            </div>
            <div class="drawer-group" data-drawer-group="play">
                <div class="drawer-row">
                    <a class="drawer-item" href="{{ site.nav.play }}">Play</a>
                    <button class="drawer-toggle" type="button" aria-expanded="false" aria-controls="drawer-play-sub" aria-label="Play sections">
                        <svg class="drawer-caret" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 5.75 8 10.25l4.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-play-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/AGPilot0001/">VALKYRIE EIRA</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/CDXPilot0004/">Particle Beat</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/CDXPilot0005/">VALKYRIE</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/CDXPilot0006/">ChibiLink</a>
                    </div>
                </div>
            </div>
            <a class="drawer-item" href="{{ site.nav.tech }}">Tech</a>
            <div class="drawer-group" data-drawer-group="diary">
                <div class="drawer-row">
                    <a class="drawer-item" href="{{ site.nav.diary }}">Diary</a>
                    <button class="drawer-toggle" type="button" aria-expanded="false" aria-controls="drawer-diary-sub" aria-label="Diary sections">
                        <svg class="drawer-caret" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 5.75 8 10.25l4.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-diary-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/diary/categories/devlog/">Devlog</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/diary/categories/architecture/">Architecture</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/diary/categories/troubleshooting/">Troubleshooting</a>
                        <a class="drawer-subitem" href="https://hyangdan2.github.io/diary/categories/notes/">Notes</a>
                    </div>
                </div>
            </div>
            {# the Info group starts open on every InformationHub page #}
            <div class="drawer-group is-open" data-drawer-group="info">
                <div class="drawer-row">
                    <a class="drawer-item{% if infoCurrent %} is-current{% endif %}" href="{{ '/' | url }}"{% if infoCurrent %} aria-current="page"{% endif %}>Info</a>
                    <button class="drawer-toggle" type="button" aria-expanded="true" aria-controls="drawer-info-sub" aria-label="Info channels">
                        <svg class="drawer-caret" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 5.75 8 10.25l4.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-info-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem{% if chinaCurrent %} is-current{% endif %}" href="{{ '/china-ai/' | url }}"{% if chinaCurrent %} aria-current="page"{% endif %}>China AI</a>
                    </div>
                </div>
            </div>
        </nav>
    </aside>

    <main id="main">
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>© {{ site.year }} {{ site.brand }}</span>
            <span class="footer-note">++ SIGNALS IN ++ NOISE OUT ++</span>
            <a href="https://github.com/{{ site.repo }}">GitHub <span aria-hidden="true">↗</span></a>
        </div>
    </footer>
    <script>window.INFO_HUB_BASE = "{{ '/' | url }}";</script>
    {% if pageScript %}<script src="{{ pageScript | url }}?v=20261119-info" defer></script>{% endif %}
    <script src="{{ '/assets/info-nav.js' | url }}?v=20261119-info" defer></script>
</body>
</html>
