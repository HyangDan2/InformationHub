---
layout: base.njk
---
{% set pager = collections.briefings | neighbors(page.url) %}
{% set day = date | koreanDate %}
{% set named = tickers | mentionedStocks(stocks) %}
{% set kind = reportKind or "daily" %}
{% set report = content | reportSections %}
<article class="post shell post-kind-{{ kind }}">
    <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ '/' | url }}">InformationHub</a>
        <span aria-hidden="true">/</span>
        <a href="{{ '/china-ai/' | url }}">China AI</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ date | isoDate }}</span>
    </nav>

    <header class="post-header">
        <p class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>China AI ·
            {% if kind == "spotlight" %}종목 스포트라이트{% else %}데일리 리포트{% endif %}
        </p>
        <h1>{{ title }}</h1>
        {% if summary %}<p class="post-summary">{{ summary }}</p>{% endif %}
        <div class="post-meta">
            <span class="kind-badge kind-{{ kind }}">{% if kind == "spotlight" %}Spotlight{% else %}Daily report{% endif %}</span>
            <time datetime="{{ date | isoDate }}">{{ day }}</time>
            <span>{{ date | timeLabel }} KST</span>
            <span>{{ content | readingTime }}분 읽기</span>
            {% if sources and sources.length %}<span>{{ sources | length }} sources</span>{% endif %}
        </div>
    </header>

    {% if named.length %}
    <div class="post-tickers" aria-label="Stocks covered">
        {% for stock in named %}
        <span class="ticker-chip"><code>{{ stock.code }}</code> {{ stock.en }}{% if stock.ko != stock.en %}<span class="ticker-ko">{{ stock.ko }}</span>{% endif %}</span>
        {% endfor %}
    </div>
    {% endif %}

    <div class="md-body post-content">
        {{ report.intro | safe }}

        {% if kind == "spotlight" %}
        {% include "parts/spotlight-viz.njk" %}
        {% endif %}

        {% for section in report.sections %}
        <section class="report-section report-section-{{ section.role }}" aria-labelledby="{{ section.title | headingId }}">
            {{ section.heading | safe }}
            {% if section.role == "market" %}{% include "parts/report-viz.njk" %}{% endif %}
            {% if section.role == "stocks" %}{% include "parts/report-sectors.njk" %}{% endif %}
            {% if section.role == "watch" and watchItems and watchItems.length %}
            {% include "parts/report-watch.njk" %}
            {% elif section.html %}
            {{ section.html | safe }}
            {% endif %}
        </section>
        {% endfor %}
    </div>

    <nav class="post-nav" aria-label="Report navigation">
        <a class="post-nav-item" href="{{ '/china-ai/' | url }}">
            <span class="post-nav-label">Channel</span>
            <strong>All China AI briefings</strong>
        </a>
        <a class="post-nav-item" href="{{ '/' | url }}">
            <span class="post-nav-label">Hub</span>
            <strong>Every channel</strong>
        </a>
    </nav>

    {% if pager.newer or pager.older %}
    <nav class="post-pager" aria-label="Previous and next reports">
        {% if pager.newer %}
        <a class="pager-item pager-newer" href="{{ pager.newer.url | url }}">
            <span>← Newer</span>
            <strong>{{ pager.newer.data.title }}</strong>
        </a>
        {% else %}<span class="pager-item pager-empty" aria-hidden="true"></span>{% endif %}
        {% if pager.older %}
        <a class="pager-item pager-older" href="{{ pager.older.url | url }}">
            <span>Older →</span>
            <strong>{{ pager.older.data.title }}</strong>
        </a>
        {% else %}<span class="pager-item pager-empty" aria-hidden="true"></span>{% endif %}
    </nav>
    {% endif %}
</article>
