---
layout: base.njk
---
{% set t = i18n[lang or 'ko'] %}
{% set pageLang = 'en' if lang == 'en' else 'ko' %}
{% set altPath = page.url | alternateUrl %}
{% set koHref = page.url if pageLang == 'ko' else altPath %}
{% set enHref = altPath if pageLang == 'ko' else page.url %}
{% import "parts/lang-switch.njk" as langSwitch %}
{% set root = ('/en/' if lang == 'en' else '/') %}
{#- Which desk filed this report: its own archive, its own name, its own watchlist. -#}
{% set channelId = channel or 'china-ai' %}
{% set ch = channels | channelOf(channelId) %}
{% set channelName = ch | pick("name", lang) %}
{% set channelUrl = (root ~ (ch.url or 'china-ai/')) | url %}
{% set postStocks = (usStocks if channelId == 'us-markets' else stocks) %}
{% if lang == 'en' %}{% set list = collections.briefingsEn %}{% set day = date | displayDate %}{% set wpm = 230 %}{% else %}{% set list = collections.briefingsKo %}{% set day = date | koreanDate %}{% set wpm = 350 %}{% endif %}
{% set list = list | ofChannel(channelId) %}
{% set pager = list | neighbors(page.url) %}
{% set named = tickers | mentionedStocks(postStocks) %}
{% set kind = reportKind or "daily" %}
{% set report = content | reportSections %}
{% set minutes = content | readingTime(wpm) %}
<article class="post shell post-kind-{{ kind }}">
    <div class="page-top">
        <nav class="crumbs" aria-label="현재 위치">
            <a href="{{ root | url }}">{{ t.channel.crumb }}</a>
            <span aria-hidden="true">/</span>
            <a href="{{ channelUrl }}">{{ channelName }}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ date | isoDate }}</span>
        </nav>
        {{ langSwitch.langSwitch(pageLang, koHref, enHref) }}
    </div>

    <header class="post-header">
        <p class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>{{ channelName }} ·
            {% if kind == "spotlight" %}{{ t.post.kindSpotlight }}{% else %}{{ t.post.kindDaily }}{% endif %}
        </p>
        <h1>{{ title }}</h1>
        {% if summary %}<p class="post-summary">{{ summary }}</p>{% endif %}
        <div class="post-meta">
            <span class="kind-badge kind-{{ kind }}">{% if kind == "spotlight" %}{{ t.kind.spotlight }}{% else %}{{ t.kind.daily }}{% endif %}</span>
            <time datetime="{{ date | isoDate }}">{{ day }}</time>
            <span>{{ date | timeLabel }} {{ t.post.timezone }}</span>
            <span>{{ t.post.readTime | fmt(minutes) }}</span>
            {% if sources and sources.length %}<span>{{ t.post.sources | fmt(sources | length) }}</span>{% endif %}
        </div>
    </header>

    {% if named.length %}
    <div class="post-tickers" aria-label="{{ t.post.tickersAria }}">
        {% for stock in named %}
        <span class="ticker-chip"><code>{{ stock.code }}</code> {{ stock | pick("name", "en") }}{% if stock.nameKo != stock.nameEn %}<span class="ticker-ko">{{ stock.nameKo }}</span>{% endif %}</span>
        {% endfor %}
    </div>
    {% endif %}

    <div class="md-body post-content">
        {{ report.intro | safe }}

        {% if kind == "spotlight" %}
        {% include "parts/spotlight-viz.njk" %}
        {% endif %}

        {% for section in report.sections %}
        <section class="report-section report-section-{{ section.role }}" aria-labelledby="{{ section.title | headingId }}">
            {{ section.heading | safe }}
            {% if section.role == "market" %}{% include "parts/report-viz.njk" %}{% endif %}
            {% if section.role == "stocks" %}{% include "parts/report-sectors.njk" %}{% endif %}
            {% if section.role == "watch" and watchItems and watchItems.length %}
            {% include "parts/report-watch.njk" %}
            {% elif section.html %}
            {{ section.html | safe }}
            {% endif %}
        </section>
        {% endfor %}
    </div>

    <nav class="post-nav" aria-label="{{ t.post.navAria }}">
        <a class="post-nav-item" href="{{ channelUrl }}">
            <span class="post-nav-label">{{ t.post.navChannelLabel }}</span>
            <strong>{{ t.post.navChannelAll | fmt(channelName) }}</strong>
        </a>
        <a class="post-nav-item" href="{{ root | url }}">
            <span class="post-nav-label">{{ t.post.navHubLabel }}</span>
            <strong>{{ t.post.navHubStrong }}</strong>
        </a>
    </nav>

    {% if pager.newer or pager.older %}
    <nav class="post-pager" aria-label="{{ t.post.pagerAria }}">
        {% if pager.newer %}
        <a class="pager-item pager-newer" href="{{ pager.newer.url | url }}">
            <span>{{ t.post.newer }}</span>
            <strong>{{ pager.newer.data.title }}</strong>
        </a>
        {% else %}<span class="pager-item pager-empty" aria-hidden="true"></span>{% endif %}
        {% if pager.older %}
        <a class="pager-item pager-older" href="{{ pager.older.url | url }}">
            <span>{{ t.post.older }}</span>
            <strong>{{ pager.older.data.title }}</strong>
        </a>
        {% else %}<span class="pager-item pager-empty" aria-hidden="true"></span>{% endif %}
    </nav>
    {% endif %}
</article>
