{%- set t = i18n[lang or 'ko'] -%}
{%- set kind = post.data.reportKind or "daily" -%}
{%- set ch = channels | channelOf(post.data.channel) -%}
<article class="brief-card" data-briefing data-kind="{{ kind }}">
    <a class="brief-link" href="{{ post.url | url }}">
        <span class="brief-meta">
            <span class="brief-channel">{{ (ch | pick("name", lang)) or "China AI" }}</span>
            <span class="kind-badge kind-{{ kind }}">{% if kind == "spotlight" %}{{ t.kind.spotlight }}{% else %}{{ t.kind.daily }}{% endif %}</span>
            <time datetime="{{ post.date | isoDate }}">{{ post.date | shortDate(lang) }}</time>
        </span>
        <span class="brief-title">{{ post.data.title }}</span>
        <span class="brief-summary">{{ post.data.summary }}</span>
        <span class="brief-foot">
            {% set nStocks = post.data.tickers | length %}
            {% set nSources = post.data.sources | length %}
            <span>{{ (t.channel.stocksOne if nStocks == 1 else t.channel.stocksMany) | fmt(nStocks) }}</span>
            <span>{{ (t.channel.sourcesOne if nSources == 1 else t.channel.sourcesMany) | fmt(nSources) }}</span>
            <span class="brief-arrow" aria-hidden="true">↗</span>
        </span>
    </a>
</article>
