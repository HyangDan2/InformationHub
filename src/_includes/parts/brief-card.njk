{%- set channelName = "China AI" -%}
{%- set kind = post.data.reportKind or "daily" -%}
<article class="brief-card" data-briefing data-kind="{{ kind }}">
    <a class="brief-link" href="{{ post.url | url }}">
        <span class="brief-meta">
            <span class="brief-channel">{{ channelName }}</span>
            <span class="kind-badge kind-{{ kind }}">{% if kind == "spotlight" %}Spotlight{% else %}Daily{% endif %}</span>
            <time datetime="{{ post.date | isoDate }}">{{ post.date | displayDate }}</time>
        </span>
        <span class="brief-title">{{ post.data.title }}</span>
        <span class="brief-summary">{{ post.data.summary }}</span>
        <span class="brief-foot">
            <span>{{ post.data.tickers | length }} stock{% if post.data.tickers | length != 1 %}s{% endif %}</span>
            <span>{{ post.data.sources | length }} sources</span>
            <span class="brief-arrow" aria-hidden="true">↗</span>
        </span>
    </a>
</article>
