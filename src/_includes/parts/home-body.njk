{% set t = i18n[lang or 'ko'] %}
{% set root = ('/en/' if lang == 'en' else '/') %}
{% set channelUrl = (root ~ 'china-ai/') | url %}
{% if lang == 'en' %}{% set briefings = collections.briefingsEn %}{% else %}{% set briefings = collections.briefingsKo %}{% endif %}
{% set live = channels | where("status", "live") %}
{% set latest = briefings[0] or null %}
{% set recent = briefings | limit(8) %}
{% set total = briefings | length %}

<section class="hero shell" aria-labelledby="hub-title">
    <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{{ site.brand }} / InformationHub</p>
        <h1 id="hub-title">{{ t.home.h1a }}<br><span>{{ t.home.h1b }}</span></h1>
        <p class="hero-description">{{ t.home.lede | safe }}</p>
        <div class="hero-actions">
            <a class="button button-primary" href="#feed">{{ t.home.ctaLatest }}</a>
            <a class="button button-ghost" href="{{ channelUrl }}">{{ t.home.ctaChannel }}</a>
        </div>
        <dl class="hero-stats">
            <div><dt>{{ t.home.statChannels }}</dt><dd>{{ live | length }}</dd></div>
            <div><dt>{{ t.home.statReports }}</dt><dd>{{ total }}</dd></div>
            <div><dt>{{ t.home.statUpdate }}</dt><dd>{% if latest %}{{ latest.date | shortDate(lang) }}{% else %}—{% endif %}</dd></div>
        </dl>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div class="hero-terminal">
            <span class="terminal-bar"><i></i><i></i><i></i></span>
            <pre><code><span class="t-dim">$</span> infohub channels
<span class="t-accent">china-ai</span>  <span class="t-text">{{ t.home.terminalChannels }}</span>

<span class="t-dim">$</span> infohub latest
<span class="t-text">{% if latest %}{{ latest.date | isoDate }} · China AI{% else %}{{ t.home.noBriefings }}{% endif %}</span>
<span class="t-dim">$</span> <span class="t-cursor">▌</span></code></pre>
        </div>
        <p>{{ t.home.filed | safe }}</p>
    </div>
</section>

<section class="channels shell" id="channels" aria-labelledby="channels-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">{{ t.home.channelsEyebrow }}</p>
            <h2 id="channels-title">{{ t.home.channelsTitle }}</h2>
        </div>
        <p>{{ t.home.channelsLede }}</p>
    </div>
    <div class="channel-grid">
        {% for channel in channels %}
        {% if channel.status == "live" %}
        <a class="channel-card" href="{{ (root ~ channel.url) | url }}">
            <span class="card-index">{{ channel.index }} / {{ channel.status | upper }}</span>
            <span class="channel-head"><span class="channel-flag" aria-hidden="true">{{ channel.flag }}</span><span class="channel-name">{{ channel | pick("name", lang) }}</span></span>
            <span class="channel-blurb">{{ channel | pick("blurb", lang) }}</span>
            <span class="channel-meta"><span>{{ channel | pick("cover", lang) }}</span><span>{{ channel | pick("cadence", lang) }}</span></span>
            <span class="channel-foot">
                <span class="channel-count">{% if total == 1 %}{{ t.home.reportOne | fmt(total) }}{% else %}{{ t.home.reportMany | fmt(total) }}{% endif %}</span>
                <span class="channel-open">{{ t.home.openChannel }} <span aria-hidden="true">↗</span></span>
            </span>
        </a>
        {% else %}
        <div class="channel-card is-planned">
            <span class="card-index">{{ channel.index }} / {{ channel.status | upper }}</span>
            <span class="channel-head"><span class="channel-flag" aria-hidden="true">{{ channel.flag }}</span><span class="channel-name">{{ channel | pick("name", lang) }}</span></span>
            <span class="channel-blurb">{{ channel | pick("blurb", lang) }}</span>
            <span class="channel-meta"><span>{{ channel | pick("cover", lang) }}</span><span>{{ channel | pick("cadence", lang) }}</span></span>
            <span class="channel-foot"><span class="channel-count">{{ t.home.notOpen }}</span><span class="channel-open">{{ t.home.reserved }}</span></span>
        </div>
        {% endif %}
        {% endfor %}
    </div>
</section>

<section class="recent shell" id="feed" aria-labelledby="feed-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">{{ t.home.feedEyebrow }}</p>
            <h2 id="feed-title">{{ t.home.feedTitle }}</h2>
        </div>
        <p>{% if total %}{% if total == 1 %}{{ t.home.feedLedeOne | fmt(total) }}{% else %}{{ t.home.feedLedeMany | fmt(total) }}{% endif %}{% else %}{{ t.home.feedLedeNone }}{% endif %}</p>
    </div>
    {% if total %}
    <form class="hub-search" role="search" data-hub-search
          data-no-match="{{ t.home.searchNoMatch }}"
          data-match-one="{{ t.home.searchMatchesOne }}"
          data-match-many="{{ t.home.searchMatchesMany }}"
          data-none="{{ t.home.searchNone }}"
          data-stocks-one="{{ t.home.searchStocksOne }}"
          data-stocks-many="{{ t.home.searchStocksMany }}"
          data-sources-one="{{ t.home.searchSourcesOne }}"
          data-sources-many="{{ t.home.searchSourcesMany }}">
        <label class="search-field" for="hub-search-input">
            <span class="search-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
            </span>
            <span class="sr-only">{{ t.home.searchLabel }}</span>
            <input class="search-input" id="hub-search-input" type="search" autocomplete="off" placeholder="{{ t.home.searchPlaceholder }}" data-search-input>
            <button class="search-clear" type="button" aria-label="{{ t.home.searchClear }}" data-search-clear hidden>
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2 2l8 8M10 2l-8 8"/></svg>
            </button>
        </label>
        <div class="search-foot">
            <p class="search-status" role="status" data-search-status>{{ t.home.searchStatus }}</p>
            <span class="search-scopes"><span class="scope-chip">{{ t.home.searchScope }}</span></span>
        </div>
    </form>
    <div class="briefing-grid" data-search-results hidden></div>
    <div class="briefing-grid" data-search-default>
        {% for post in recent %}
        {% include "parts/brief-card.njk" %}
        {% endfor %}
    </div>
    <p class="feed-more" data-search-default><a href="{{ channelUrl }}">{{ t.home.everyReport }} <span aria-hidden="true">↗</span></a></p>
    {% else %}
    <p class="empty-state">{{ t.home.feedEmpty }}</p>
    {% endif %}
</section>

<section class="cta-band shell">
    <div>
        <h2>{{ t.home.ctaTitle1 }}<br><span>{{ t.home.ctaTitle2 }}</span></h2>
        <p>{{ t.home.ctaLede }}</p>
    </div>
    <a class="button button-primary" href="{{ channelUrl }}">{{ t.home.ctaButton }} <span aria-hidden="true">↗</span></a>
</section>
